+  struct run *r;
+  uint64 free_pages = 0;
+  
+  acquire(&kmem.lock);
+  r = kmem.freelist;
+  while(r) {
+    free_pages++;
+    r = r->next;
+  }
+  release(&kmem.lock);
+
+  return free_pages * PGSIZE;
+}
