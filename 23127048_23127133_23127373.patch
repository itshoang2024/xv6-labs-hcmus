+-    if (token_end) *token_end = pos; // Vi tri ket thuc cua toekn
+-    if (pos < end_pos) *pos++ = 0; // Tach token
+-
+-    // Bo khoang trang
+-    while (pos < end_pos && strchr(whitespace_chars, *pos)) pos++;
+-    *current_pos = pos; // cap nhat pos tiep theo
+-    return token_type;
+-}
