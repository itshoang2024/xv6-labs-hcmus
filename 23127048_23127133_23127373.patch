+-
+-    // Doc lenh va xu li
+-    while (read_command(input_buffer, sizeof(input_buffer)) >= 0) {
+-        int arg_index = argc - 1; 
+-        char *current_pos = input_buffer;
+-        char *end_pos = current_pos + strlen(current_pos);
+-
+-        // Lap qua tung token
