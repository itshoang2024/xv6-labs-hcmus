+-// Stdin
+-int read_command(char *buffer, int buffer_size) {
+-    memset(buffer, 0, buffer_size); 
+-    int length = read(0, buffer, buffer_size - 1); // stdin
+-    if (length <= 0) return -1; 
+-    buffer[length] = 0;
+-    return 0;
+-}
+-
